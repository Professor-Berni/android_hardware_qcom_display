cc_defaults {
    name: "display_defaults",
    cflags: [
        "-Wno-missing-field-initializers",
        "-Wconversion",
        "-Wall",
        "-Werror",
        "-DDEBUG_CALC_FPS",
        "-Wno-sign-conversion",
        "-DVENUS_COLOR_FORMAT",
        "-DMDSS_TARGET",
        "-D__STDC_FORMAT_MACROS",
    ] + select(soong_config_variable("qtidisplay", "headless"), {
        "true": ["-DTARGET_HEADLESS"],
        default: [],
    }),
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libEGL",
    ],
    header_libs: ["display_headers"],
}

cc_library_headers {
    name: "display_headers",
    vendor_available: true,
    export_include_dirs: [
        "libcopybit",
        "libgralloc",
        "libhdmi",
        "libhwcomposer",
        "liboverlay",
        "libqdutils",
        "libqservice",
    ],
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
}

cc_library_headers {
    name: "display_intf_headers",
    vendor_available: true,
    export_include_dirs: [
        "libgralloc",
        "libqdutils",
    ],
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
}
