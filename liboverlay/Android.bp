cc_library_shared {
    name: "liboverlay",
    defaults: ["display_defaults"],
    vendor: true,
    srcs: [
        "overlay.cpp",
        "overlayUtils.cpp",
        "overlayMdp.cpp",
        "overlayRotator.cpp",
        "overlayMdpRot.cpp",
        "overlayMdssRot.cpp",
        "overlayWriteback.cpp",
        "overlayCursor.cpp",
        "pipes/overlayGenPipe.cpp",
    ],
    shared_libs: [
        "libqdutils",
        "libmemalloc",
        "libsync",
        "libdl",
    ],
    cflags: [
        "-DLOG_TAG=\"qdoverlay\"",
    ],
    header_libs: [
        "display_headers",
        "generated_kernel_headers",
    ],
}
