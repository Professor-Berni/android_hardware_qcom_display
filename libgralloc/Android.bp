soong_config_module_type {
    name: "target_board_platform_cc_library_shared",
    module_type: "cc_library_shared",
    config_namespace: "ANDROID",
    value_variables: ["target_board_platform"],
    properties: [
        "name",
    ],
}

target_board_platform_cc_library_shared {
    name: "gralloc.qcom",
    soong_config_variables: {
        target_board_platform: {
            name: "gralloc.%s",
            conditions_default: {
                name: "gralloc.qcom",
            },
        },
    },
    defaults: ["display_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "gpu.cpp",
        "gralloc.cpp",
        "framebuffer.cpp",
        "mapper.cpp",
    ],
    shared_libs: [
        "libqdMetaData",
        "libmemalloc",
        "libhardware",
        "libqdutils",
        "libGLESv1_CM",
    ],
    cflags: [
        "-DLOG_TAG=\"qdgralloc\"",
    ],
    header_libs: [
        "display_headers",
        "generated_kernel_headers",
        "libhardware_headers",
    ],
}

cc_library_shared {
    name: "libmemalloc",
    defaults: ["display_defaults"],
    vendor: true,
    srcs: [
        "ionalloc.cpp",
        "alloc_controller.cpp",
    ],
    shared_libs: [
        "libqdutils",
        "libdl",
        "libhardware",
    ],
    cflags: [
        "-DLOG_TAG=\"qdgralloc\"",
    ],
    header_libs: [
        "display_headers",
        "generated_kernel_headers",
        "libhardware_headers",
    ],
}
